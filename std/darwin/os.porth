// Platform ABI definitions for macOS.
//
// Selected with `porth com -os darwin`; exports the same names as
// `std/os.porth`, with the values from the Darwin headers.  Typedefs matter
// here: Darwin's `tcflag_t` is `unsigned long` rather than `unsigned int`, so
// `struct termios` is 72 bytes with the flags 8 bytes wide, and `struct stat`
// puts the mode before the inode.
//
// Sources: xnu `bsd/sys/stat.h` (`__DARWIN_STRUCT_STAT64`), `bsd/sys/termios.h`,
// `bsd/sys/sockaddr.h`, `bsd/sys/mman.h`, `sys/errno.h`, `sys/fcntl.h`.
//
// The ioctl requests stay the Linux numbers on purpose: they are handles the
// emitted C runtime translates into the Darwin call (`TCGETS`/`TCSETS`/
// `TCSETSF` become `tcgetattr`/`tcsetattr`, `TIOCGWINSZ` is passed to the
// native `ioctl`).  A real Darwin request code would never reach the kernel.

include "core.porth"

const O_RDONLY     0x0 end
const O_WRONLY     0x1 end
const O_RDWR       0x2 end
const O_CREAT      0x200 end
const O_TRUNC      0x400 end
const O_NONBLOCK   0x4 end

const F_SETFL 4 end
const F_GETFL 3 end

const EPERM         1 end
const ENOENT        2 end
const EINTR         4 end
const EIO           5 end
const EAGAIN       35 end
const ENOMEM       12 end
const EACCES       13 end
const EFAULT       14 end
const ENOTDIR      20 end
const EINVAL       22 end
const ENAMETOOLONG 63 end
const ELOOP        62 end

// Darwin numbers CLOCK_MONOTONIC 6 in <time.h>; it is not the Linux 1.
const CLOCK_MONOTONIC 6 end
const TIMER_ABSTIME   1 end

const MAP_PRIVATE 2 end
const MAP_ANONYMOUS 0x1000 end
const PROT_READ 1 end
const PROT_WRITE 2 end

const SIGQUIT 3 end
const SIGINT  2 end

// struct timespec { time_t tv_sec; long tv_nsec; };  same as Linux.
const timespec.tv_sec  sizeof(int) offset end
const timespec.tv_nsec sizeof(int) offset end
const sizeof(timespec) reset end

// struct stat from __DARWIN_STRUCT_STAT64:
//   dev_t(4) st_dev, mode_t(2) st_mode, nlink_t(2) st_nlink, ino_t(8) st_ino,
//   uid(4), gid(4), rdev(4), 4 x timespec, off_t st_size, ...
const stat.st_dev     0   end
const stat.st_ino     8   end
const stat.st_mode    4   end
const stat.st_nlink   6   end
const stat.st_uid     16  end
const stat.st_gid     20  end
const stat.st_rdev    24  end
const stat.st_size    96  end
const stat.st_blksize 112 end
const stat.st_blocks  104 end
const stat.st_atim    32  end
const stat.st_mtim    48  end
const stat.st_ctim    64  end
const sizeof(stat) 144 end
const sizeof(stat.st_dev) sizeof(u32) end
const sizeof(stat.st_ino) sizeof(u64) end
const sizeof(stat.st_mode) sizeof(u16) end
const sizeof(stat.st_nlink) sizeof(u16) end
const sizeof(stat.st_uid) sizeof(u32) end
const sizeof(stat.st_gid) sizeof(u32) end
const sizeof(stat.st_rdev) sizeof(u32) end
const sizeof(stat.st_size) sizeof(u64) end
const sizeof(stat.st_blksize) sizeof(u32) end
const sizeof(stat.st_blocks) sizeof(u64) end
const sizeof(stat.st_atim) sizeof(timespec) end
const sizeof(stat.st_mtim) sizeof(timespec) end
const sizeof(stat.st_ctim) sizeof(timespec) end

// struct sockaddr { u8 sa_len; u8 sa_family; char sa_data[14]; };  Note the
// leading length byte: sin_family is one byte at offset 1, not two bytes at 0.
const sizeof(sockaddr) 16 end
const sockaddr_in.sin_family 1 end
const sockaddr_in.sin_port 2 end
const sockaddr_in.sin_addr 4 end
const sizeof(sockaddr_in.sin_family) 1 end
const sizeof(sockaddr_in.sin_port) 2 end
const sizeof(sockaddr_in.sin_addr) 4 end

const AF_INET 2 end
const SOCK_STREAM 1 end
// NOTE: This is not standard. I invented this constant as an opposite ot INADDR_ANY
const INADDR_LOCAL 16777343 end

const PATH_MAX 1024 end

// struct termios { tcflag_t c_iflag, c_oflag, c_cflag, c_lflag; cc_t c_cc[NCCS];
//                  speed_t c_ispeed, c_ospeed; }  with tcflag_t/speed_t = u64,
// cc_t = u8 and NCCS = 20, so the flags are 8 bytes wide and the struct is 72.
const sizeof(tcflag_t) sizeof(u64) end
const sizeof(cc_t) sizeof(u8) end
const NCCS 20 end
const termios.c_iflag 0 end
const termios.c_oflag 8 end
const termios.c_cflag 16 end
const termios.c_lflag 24 end
const termios.c_cc 32 end
const sizeof(termios) 72 end

// STRUCT winsize { unsigned short ws_row, ws_col, ws_xpixel, ws_ypixel; };
const winsize.ws_row sizeof(u16) offset end
const winsize.ws_col sizeof(u16) offset end
const winsize.ws_xpixel sizeof(u16) offset end
const winsize.ws_ypixel sizeof(u16) offset end
const sizeof(winsize) reset end

const TIOCGWINSZ 0x5413 end
const TCGETS     0x5401 end
const TCSETS     0x5402 end
const TCSETSF    0x5404 end
const ICANON     0x100 end
const ECHO       0x8 end
const VTIME      17 end
const VMIN       16 end

const TCSAFLUSH 2 end
const TCSANOW 0 end

// struct sigaction { union __sigaction_u __sigaction_u; sigset_t sa_mask;
//                    int sa_flags; }  Darwin has no kernel restorer.
const sizeof(sigaction) 16 end
const sigaction.handler 0 end
const sigaction.flags 12 end
const sigaction.restorer 0 end
const SA_RESTORER 0 end
