// Linux syscall handles and the wrappers built on them.
//
// The numbers below are the x86_64 Linux table, but they are treated as
// OS-independent handles: every backend that is not Linux translates them at
// the call site (the C runtime dispatches on these numbers, `fasmarm` maps them
// to the aarch64 table).  A program can therefore call `write` on any target.
//
// The values that are *not* handles, that get inlined into the program as
// numbers -- struct layouts, flag bits, errno values, ioctl requests -- live in
// os.porth, which has one implementation per OS.  Use `porth com -os <name>` to
// pick a different one.

include "core.porth"
include "os.porth"

/// Syscalls
// Stolen from https://filippo.io/linux-syscall-table/
// Not all of the syscalls here are useful/implemented. I literally just copy-pasted them.
