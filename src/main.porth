proc usage
  ptr // program name
  int // fd
in
  let name fd in
    "Usage: " eputs name cstr-to-str puts " [OPTIONS] <SUBCOMMAND>\n"                          fd fputs
    "  OPTIONS:\n"                                                                             fd fputs
    "    -unsafe               Disable type checking.\n"                                       fd fputs
    "    -I <path>             Add <path> to the include paths list.\n"                        fd fputs
    "  SUBCOMMANDS:\n"                                                                         fd fputs
    "    com [OPTIONS] <file>  Compile the program\n"                                          fd fputs
    "      OPTIONS:\n"                                                                         fd fputs
    "        -o <path>           Write the executable to <path>.\n"                              fd fputs
    "        -r                  Run the program after successful compilation\n"               fd fputs
    "        -s                  Silent mode. Don't print any info about compilation phases\n" fd fputs
    "        -f <format>         Output format: fasm (x86_64), fasmarm (AArch64),\n"       fd fputs
    "                            c (portable C) or yasm (x86_64). Default is `-f fasm`.\n" fd fputs
    "                            list of formats specify `-f list`.\n"                     fd fputs
    "        -os <os>            OS ABI module to compile against: linux (default),\n"    fd fputs
    "                            darwin or windows. Only valid with -f c.\n"             fd fputs
    "        -a                  Annotate IR instructions in the output assembly.\n"           fd fputs
    "    dump <file>           Dump the ops of the program\n"                                  fd fputs
    "    lex <file>            Produce lexical analysis of the file\n"                         fd fputs
    "    summary <file>        Print the summary of the program\n"                             fd fputs
    "    help                  Print this help to stdout and exit with 0 code\n"               fd fputs
  end
end

proc summary in
  "Ops count:                    " puts ops-count              @ putu "/" puts OPS_CAP             putu "\n" puts
  "Consts count:                 " puts consts-count           @ putu "/" puts CONST_CAP           putu "\n" puts
  "Procs count:                  " puts procs-count            @ putu "/" puts PROCS_CAP           putu "\n" puts
  "String literals count:        " puts strlits-count          @ putu "/" puts STRLITS_CAP         putu "\n" puts
  "String literals size (bytes): " puts strbuf-size            @ putu "/" puts STRBUF_CAP          putu "\n" puts
  "Global memories count:        " puts global-memories-count  @ putu "/" puts GLOBAL_MEMORIES_CAP putu "\n" puts
  // NOTE: global memory size does not have an upper capacity limit since it's
  // just a counter of how big of region to allocate in the .bss section
  "Global memory size (bytes):   " puts global-memory-capacity @ putu "\n" puts
  "Type Frames leaked:           " puts type-frame-pool-count  @ putu "/" puts TYPE_FRAME_POOL_CAP putu "\n" puts
  "Type Frame size (bytes):      " puts sizeof(TypeFrame) putu "\n" puts
end

const FORMAT_FASM 1 offset end
const FORMAT_YASM 1 offset end
const FORMAT_FASMARM 1 offset end
const FORMAT_C 1 offset end
const COUNT_FORMATS  reset end

// Which OS's ABI module std/os.porth resolves to.  The C backend detects the
// host by itself; this only picks the numbers the program bakes in, and the
// generated runtime refuses to build for a different OS.
const OS_LINUX 1 offset end
const OS_DARWIN 1 offset end
const OS_WINDOWS 1 offset end
const COUNT_OS reset end

inline proc format-name int -- int ptr in
  let format in
    assert "Exhaustive handling of output formats in format-name" COUNT_FORMATS 4 = end
         format FORMAT_FASM = if  "fasm"
    else format FORMAT_YASM = if* "yasm"
    else format FORMAT_FASMARM = if* "fasmarm"
    else format FORMAT_C = if* "c"
    else
      str-null
      here eputs ": Assertion Failed: unreachable" eputs
      1 exit
    end
  end
end

inline proc format-by-name int ptr -- int bool in
  let n s in
    assert "Exhaustive handling of output format-by-name" COUNT_FORMATS 4 = end
    n s "fasm" streq if
      FORMAT_FASM true
    else n s "yasm" streq if*
      FORMAT_YASM true
    else n s "fasmarm" streq if*
      FORMAT_FASMARM true
    else n s "c" streq if*
      FORMAT_C true
    else
      69 // UB
      false
    end
  end
end

proc main in
  // Default include paths
  "."     include-paths-add
  "./std" include-paths-add

  memory args sizeof(ptr) end
  argv args !ptr

  memory program sizeof(ptr) end
  args @@ptr program !ptr

  memory unsafe sizeof(bool) end
  false unsafe !bool

  while
    args sizeof(ptr) inc64-by
    args @@ptr NULL ptr= if
      false // break
    else args @@ptr "-unsafe"c cstreq if*
      true unsafe !bool
      true  // continue
    else args @@ptr "-I"c cstreq if*
      args sizeof(ptr) inc64-by
      args @@ptr
        dup ?null if
          "ERROR: no argument is provided for -I flag\n" eputs
          1 exit
        end
        dup cstr-to-str include-paths-add
      drop
      true // continue
    else
      false // break
    end
  do end

  args @@ptr NULL ptr= if
    program @ptr stderr usage
    "ERROR: subcommand is not provided\n" eputs
    1 exit
  end

  memory input-file-path-cstr sizeof(ptr) end
  NULL input-file-path-cstr !ptr
  memory base-file-path sizeof(Str) end
  0 NULL base-file-path !Str
  memory output-file-path sizeof(Str) end
  0 NULL output-file-path !Str
  memory output-file-given sizeof(bool) end
  false output-file-given !bool
  memory run sizeof(bool) end
  false run !bool
  memory format sizeof(int) end
  FORMAT_FASM format !int

  args @@ptr "com"c cstreq if
    while
      args sizeof(ptr) inc64-by
      args @@ptr NULL ptr= if
        false // break
      else args @@ptr "-r"c cstreq if*
        true run !bool
        true  // continue
      else args @@ptr "-s"c cstreq if*
        true silent !
        true  // continue
      else args @@ptr "-a"c cstreq if*
        true annotate !
        true  // continue
      else args @@ptr "-o"c cstreq if*
        args sizeof(ptr) inc64-by
        args @@ptr
        dup ?null if
          "ERROR: no argument is provided for -o flag\n" eputs
          1 exit
        end
        cstr-to-str output-file-path !Str
        true output-file-given !bool
        true // continue
      else args @@ptr "-f"c cstreq if*
        args sizeof(ptr) inc64-by
        args @@ptr
        let arg in
          arg ?null if
            "ERROR: no argument is provided for -f flag. Use `-f list` to get the list of available formats.\n" eputs
            1 exit
          end

          arg "list"c cstreq if
            "Available formats:\n" puts
            0 while dup COUNT_FORMATS < do
              dup format-name puts "\n" puts
              1 +
            end drop
            0 exit
          end

          arg cstr-to-str format-by-name lnot if
            "ERROR: unknown output format `"                           eputs
            arg cstr-to-str                                            eputs
            "`. Use `-f list` to get the list of available formats.\n" eputs
            1 exit
          end
          format !int
        end
        true // continue
      else args @@ptr "-os"c cstreq if*
        args sizeof(ptr) inc64-by
        args @@ptr
          dup ?null if
            "ERROR: no argument is provided for -os flag\n" eputs
            1 exit
          end
          dup "linux"c cstreq if
            drop
          else dup "darwin"c cstreq if*
            drop
            OS_DARWIN os !
            "./std/darwin"c cstr-to-str include-paths-prepend
          else dup "windows"c cstreq if*
            drop
            OS_WINDOWS os !
            "./std/windows"c cstr-to-str include-paths-prepend
          else
            "ERROR: unknown OS `" eputs
            cstr-to-str          eputs
            "`. Use linux, darwin or windows.\n" eputs
            1 exit
          end
        true // continue
      else
        args @@ptr input-file-path-cstr !ptr
        args sizeof(ptr) inc64-by
        false // break
      end
    do end

    input-file-path-cstr @ptr NULL ptr= if
      program @ptr stderr usage
      "[ERROR] no input file is provided for the compilation.\n" eputs
      1 exit
    end

    // The asm backends emit Linux binaries.  FASM on macOS is allowed because
    // macOS x86_64 uses the same syscall instruction; the syscall numbers come
    // from std/darwin/linux.porth.  (FASM cannot emit Mach-O with this version,
    // so the result is still ELF; use -f c for native Mach-O/PE output.)
    format @int FORMAT_C != os @ OS_LINUX != land if
      format @int FORMAT_FASM = os @ OS_DARWIN = land lnot if
        program @ptr stderr usage
        "[ERROR] -os <name> requires -f c.\n" eputs
        1 exit
      end
    end

    output-file-given @bool if
      output-file-path @Str base-file-path !Str
    else
      input-file-path-cstr @ptr cstr-to-str remove-ext base-file-path !Str
    end

    input-file-path-cstr @ptr compile-program-into-ops
    unsafe @bool lnot if type-check-program end

    dce
    optimize

    format @int FORMAT_FASM = if
      timeit/from-here
        fpb-end
          base-file-path @Str fpb-append drop
          ".asm"              fpb-append drop
          1                   fpb-alloc  drop
          dup generate-fasm-linux-x86_64
        fpb-rewind
      "[PROFILE] Generation" silent @ timeit/to-here

      timeit/from-here
        cmd-dev-null-stdout @
          silent @ cmd-dev-null-stdout !
          fpb-end
            tmp-end
            "fasm"c       tmp-append-ptr
            "-m"c         tmp-append-ptr
            "524288"c     tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".asm"              fpb-append drop
              1                   fpb-alloc  drop
              tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".tmp"              fpb-append drop
              1                   fpb-alloc  drop
              tmp-append-ptr
            NULL          tmp-append-ptr
            silent @ lnot cmd-echoed
          fpb-rewind
        cmd-dev-null-stdout !

        fpb-end
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop

          fpb-end
            base-file-path @Str fpb-append drop
            ".tmp"              fpb-append drop
            1                   fpb-alloc  drop

          silent @ lnot if
            "[INFO] renaming " puts
            dup cstr-to-str    puts
            " -> "             puts
            over cstr-to-str   puts
            "\n"               puts
          end

          rename 0 < if
            "ERROR: could not rename the file\n" eputs
            1 exit
          end
        fpb-rewind

        fpb-end
          tmp-end
          "chmod"c      tmp-append-ptr
          "+x"c         tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          NULL          tmp-append-ptr
          silent @ lnot cmd-echoed
        fpb-rewind
      "[PROFILE] fasm" silent @ timeit/to-here
    else format @int FORMAT_FASMARM = if*
      timeit/from-here
        fpb-end
          base-file-path @Str fpb-append drop
          ".asm"              fpb-append drop
          1                   fpb-alloc  drop
          dup generate-fasmarm-linux-aarch64
        fpb-rewind
      "[PROFILE] Generation" silent @ timeit/to-here

      timeit/from-here
        cmd-dev-null-stdout @
          silent @ cmd-dev-null-stdout !
          fpb-end
            tmp-end
            "fasmarm"c    tmp-append-ptr
            "-m"c         tmp-append-ptr
            "65536"c      tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".asm"              fpb-append drop
              1                   fpb-alloc  drop
              tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".tmp"              fpb-append drop
              1                   fpb-alloc  drop
              tmp-append-ptr
            NULL          tmp-append-ptr
            silent @ lnot cmd-echoed
          fpb-rewind
        cmd-dev-null-stdout !

        fpb-end
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop

          fpb-end
            base-file-path @Str fpb-append drop
            ".tmp"              fpb-append drop
            1                   fpb-alloc  drop

          silent @ lnot if
            "[INFO] renaming " puts
            dup cstr-to-str    puts
            " -> "             puts
            over cstr-to-str   puts
            "\n"               puts
          end

          rename 0 < if
            "ERROR: could not rename the file\n" eputs
            1 exit
          end
        fpb-rewind

        fpb-end
          tmp-end
          "chmod"c      tmp-append-ptr
          "+x"c         tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          NULL          tmp-append-ptr
          silent @ lnot cmd-echoed
        fpb-rewind
      "[PROFILE] fasmarm" silent @ timeit/to-here
    else format @int FORMAT_C = if*
      timeit/from-here
        fpb-end
          base-file-path @Str fpb-append drop
          ".c"                fpb-append drop
          1                   fpb-alloc  drop
          dup generate-c
        fpb-rewind
      "[PROFILE] Generation" silent @ timeit/to-here

      timeit/from-here
        cmd-dev-null-stdout @
          silent @ cmd-dev-null-stdout !
          fpb-end
            tmp-end
            "cc"c        tmp-append-ptr
            "-O2"c       tmp-append-ptr
            "-w"c        tmp-append-ptr
            "-o"c        tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".tmp"             fpb-append drop
              1                  fpb-alloc  drop
              tmp-append-ptr
            fpb-end
              base-file-path @Str fpb-append drop
              ".c"               fpb-append drop
              1                  fpb-alloc  drop
              tmp-append-ptr
            NULL         tmp-append-ptr
            silent @ lnot cmd-echoed
          fpb-rewind
        cmd-dev-null-stdout !

        fpb-end
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop

          fpb-end
            base-file-path @Str fpb-append drop
            ".tmp"              fpb-append drop
            1                   fpb-alloc  drop

          silent @ lnot if
            "[INFO] renaming " puts
            dup cstr-to-str    puts
            " -> "             puts
            over cstr-to-str   puts
            "\n"               puts
          end

          rename 0 < if
            "ERROR: could not rename the file\n" eputs
            1 exit
          end
        fpb-rewind

        fpb-end
          tmp-end
          "chmod"c      tmp-append-ptr
          "+x"c         tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          NULL          tmp-append-ptr
          silent @ lnot cmd-echoed
        fpb-rewind
      "[PROFILE] cc" silent @ timeit/to-here
    else format @int FORMAT_YASM = if*
      timeit/from-here
        fpb-end
          base-file-path @Str fpb-append drop
          ".asm"              fpb-append drop
          1                   fpb-alloc  drop
          dup generate-yasm-linux-x86_64
        fpb-rewind
      "[PROFILE] Generation" silent @ timeit/to-here

      timeit/from-here
        fpb-end
          tmp-end
          "yasm"c    tmp-append-ptr
          "-felf64"c tmp-append-ptr
          "-g"c      tmp-append-ptr
          "dwarf2"c  tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            ".asm"              fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          NULL          tmp-append-ptr
          silent @ lnot cmd-echoed
        fpb-rewind

        fpb-end
          tmp-end
          "ld"c      tmp-append-ptr
          "-o"c      tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          fpb-end
            base-file-path @Str fpb-append drop
            ".o"                fpb-append drop
            1                   fpb-alloc  drop
            tmp-append-ptr
          NULL          tmp-append-ptr
          silent @ lnot cmd-echoed
        fpb-rewind
      "[PROFILE] yasm" silent @ timeit/to-here
    else
      here eputs ": Assertion Failed: unreachable" eputs
      1 exit
    end

    run @bool if
      tmp-end
      fpb-end
        base-file-path @Str fpb-append drop
        1 fpb-alloc drop
        tmp-append-ptr
      while args @@ptr NULL ptr!= do
        args @@ptr tmp-append-ptr
        args sizeof(ptr) inc64-by
      end
      NULL        tmp-append-ptr
      silent @ lnot cmd-echoed
    end
  else args @@ptr "help"c cstreq if*
    program @ptr stdout usage
    0 exit
  else args @@ptr "dump"c cstreq if*
    args sizeof(ptr) inc64-by
    args @@ptr NULL ptr= if
      program @ptr stderr usage
      "ERROR: no input file is provided for the `dump` subcommand\n" eputs
      1 exit
    end

    args @@ptr compile-program-into-ops
    unsafe @bool lnot if type-check-program end
    dce

    dump-ops
  else args @@ptr "lex"c cstreq if*
    args sizeof(ptr) inc64-by
    args @@ptr NULL ptr= if
      program @ptr stderr usage
      "ERROR: no input file is provided for the `lex` subcommand\n" eputs
      1 exit
    end

    args @@ptr lex-file
  else args @@ptr "summary"c cstreq if*
    args sizeof(ptr) inc64-by
    args @@ptr NULL ptr= if
      program @ptr stderr usage
      "ERROR: no input file is provided for the `dump` subcommand\n" eputs
      1 exit
    end

    args @@ptr compile-program-into-ops
    unsafe @bool lnot if type-check-program end

    summary
  else
    program @ptr stderr usage
    "ERROR: unknown subcommand `" eputs args @@ptr cstr-to-str eputs "`\n" eputs
    1 exit
  end
end
